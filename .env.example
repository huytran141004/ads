# Cổng chạy ứng dụng web Express
PORT=3000

# Endpoint API nhà cung cấp Baostar (Chuẩn SMM Panel v2)
BAOSTAR_API_URL=https://www.baostar.org/api/v2

# API Key lấy tại tài khoản đại lý Baostar của bạn (Giữ tuyệt mật)
BAOSTAR_API_KEY=your_api_key_here

# ID dịch vụ tăng bình luận Facebook trên hệ thống Baostar
SERVICE_ID=your_service_id_here

